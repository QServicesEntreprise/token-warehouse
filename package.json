{
  "name": "token-warehouse",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build:web": "ng build token-warehouse-web",
    "start:web": "ng serve token-warehouse-web --host 127.0.0.1 --port 4200",
    "test:web": "ng test token-warehouse-web --watch=false --no-progress",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run build:web && npm run test:web && npm run test:architecture && dotnet build TokenWarehouse.slnx && dotnet test TokenWarehouse.slnx --no-build && npm run test:e2e"
  },
  "dependencies": {
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.3",
    "@playwright/test": "1.62.1",
    "jsdom": "30.0.1",
    "typescript": "6.0.0-beta",
    "vitest": "4.1.11"
  }
}
